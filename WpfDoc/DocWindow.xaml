<Window x:Class="WpfDoc.DocWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfDoc"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d"
        Title="DocWindow" Height="450" Width="800">
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.New" Executed="NewFile_Executed"/>
        <CommandBinding Command="ApplicationCommands.Open" Executed="OpenFile_Executed"/>
        <CommandBinding Command="ApplicationCommands.Save" Executed="SaveFile_Executed"/>
    </Window.CommandBindings>
    <DockPanel>
        <ToolBarTray Height="40" VerticalAlignment="Top" HorizontalAlignment="Left" DockPanel.Dock="Top" Background="Azure">
            <ToolBar x:Name="Yee" Height="40" Width="200" Background="#FFF3B2DD">
                <Button x:Name="NewFile" Height="32" Width="32" Command="ApplicationCommands.New">
                    <Image Height="26" Width="29" Source="/addnew.png"/>
                </Button>
                <Button x:Name="OpenFile" Height="32" Width="32" Command="ApplicationCommands.Open">
                    <Image Height="26" Width="29" Source="/openfile.png"/>
                </Button>
                <Button x:Name="SaveFile" Height="32" Width="32" Command="ApplicationCommands.Save">
                    <Image Height="26" Width="29" Source="/save.png"/>
                </Button>
                <Button x:Name="DelAll" Height="32" Width="32">
                    <Image Height="26" Width="29" Source="/del.png"/>
                </Button>
            </ToolBar>
            <ToolBar x:Name="Yee2" Height="40" Width="300" Background="#FFEEB3FD">
                <ToggleButton x:Name="Bold" Height="32" Width="32" Command="EditingCommands.ToggleBold">
                    <Image Height="26" Width="29" Source="/bold.png" />
                </ToggleButton>
                <ToggleButton x:Name="Iwhatever" Height="32" Width="32" Command="EditingCommands.ToggleItalic">
                    <Image Height="26" Width="29" Source="/letteri.png"/>
                </ToggleButton>
                <ToggleButton x:Name="Underline" Height="32" Width="32" Command="EditingCommands.ToggleUnderline">
                    <Image Height="26" Width="29" Source="/underline.png"/>
                </ToggleButton>
                <xctk:ColorPicker x:Name="FontColorPicker" Width="100" Height="32" DisplayColorAndName="True"/>
                <ComboBox x:Name="FontFamilyComboBox" Height="32" Width="100"/>
                <ComboBox x:Name="FontSizeComboBox" Height="32" Width="50" />
            </ToolBar>
        </ToolBarTray>
        <RichTextBox Background="Honeydew"/>
    </DockPanel>
</Window>
